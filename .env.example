# Port for the vault-api HTTP server (default: 3063)
PORT=3063

# Obsidian LiveSync CouchDB Configuration
LIVESYNC_COUCHDB_URI=https://couchdb.example.com/database
LIVESYNC_COUCHDB_USER=user
LIVESYNC_COUCHDB_PASSWORD=password
LIVESYNC_COUCHDB_DBNAME=database
LIVESYNC_PASSPHRASE=your-encryption-passphrase

# Security & 2FA Protected Files Configuration
# Comma-separated glob patterns for protected files/folders (or via .config/protected-patterns.json in the vault)
PROTECTED_FILE_PATTERNS=Private/**,*.secret.md,Finances/**

# Base32 TOTP secret key for 2FA authenticator apps (e.g. Google Authenticator, 1Password)
# You can generate one using: bun -e "import * as OTPAuth from 'otpauth'; console.log(new OTPAuth.Secret({ size: 20 }).base32)"
AUTH_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Duration (in minutes) that a 2FA unlock remains active for a session (default: 5)
AUTH_SESSION_TTL_MINUTES=5

# Directory for SQLite knowledge graph index cache (default: .graph-cache)
GRAPH_CACHE_DIR=.graph-cache

